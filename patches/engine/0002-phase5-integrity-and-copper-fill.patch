+std::vector<std::pair<int, std::vector<std::string>>> PNS_RL_ROUTER::getPadClusterMembers() const
+{
+    std::vector<std::pair<int, std::vector<std::string>>> result;
+
+    auto connectivity = m_board->GetConnectivity();
+
+    if( !connectivity )
+        return result;
+
+    connectivity->RecalculateRatsnest();
+
+    for( const std::shared_ptr<CN_CLUSTER>& cluster :
+         connectivity->GetConnectivityAlgo()->GetClusters() )
+    {
+        if( !cluster->HasValidNet() )
+            continue;
+
+        std::vector<std::string> members;
+
+        for( CN_ITEM* item : *cluster )
+        {
+            BOARD_CONNECTED_ITEM* parent = item->Parent();
+
+            if( !parent || parent->Type() != PCB_PAD_T )
+                continue;
+
+            PAD* pad = static_cast<PAD*>( parent );
+            FOOTPRINT* footprint = dynamic_cast<FOOTPRINT*>( pad->GetParent() );
+
+            if( !footprint )
+                continue;
+
+            members.push_back( physicalPadIdentity( pad, footprint ) );
+        }
+
+        if( !members.empty() )
+        {
+            std::sort( members.begin(), members.end() );
+            result.emplace_back( cluster->OriginNet(), std::move( members ) );
+        }
+    }
+
+    return result;
+}
