+std::vector<RLBoardItemInfo> PNS_RL_ROUTER::getBoardItems() const
+{
+    std::vector<RLBoardItemInfo> result;
+
+    auto add =
+            [&]( BOARD_ITEM* item, const std::string& source,
+                 const std::string& parentKind, const std::string& parentRef )
+            {
+                if( !item )
+                    return;
+
+                RLBoardItemInfo info;
+                info.uuid        = item->m_Uuid.AsString().ToStdString();
+                info.kind        = boardItemKind( item );
+                info.source      = source;
+                info.parent_kind = parentKind;
+                info.parent_ref  = parentRef;
+                info.layer       = static_cast<int>( item->GetLayer() );
+                info.net_code    = -1;
+
+                if( BOARD_CONNECTED_ITEM* connected =
+                            dynamic_cast<BOARD_CONNECTED_ITEM*>( item ) )
+                {
+                    if( NETINFO_ITEM* net = connected->GetNet() )
+                        info.net_code = net->GetNetCode();
+                }
+
+                info.physical_id = boardItemSemantic( item, info.kind, parentRef );
+                result.push_back( info );
+            };
+
+    // The board's own containers. Every item the board owns lives in exactly one
+    // of these; the container names travel with the row so an ambiguous UUID can
+    // be reported by where it came from, never by where it happens to sit.
+    for( BOARD_ITEM* item : m_board->Tracks() )
+        add( item, "board.tracks", "board", "" );
+
+    for( PAD* pad : m_board->GetPads() )          // aggregates footprint pads
+    {
+        FOOTPRINT* parent = pad->GetParentFootprint();
+        add( pad, "board.pads", "footprint",
+             parent ? parent->GetReference().ToStdString() : std::string() );
+    }
+
+    for( ZONE* zone : m_board->Zones() )
+        add( zone, "board.zones", "board", "" );
+
+    for( BOARD_ITEM* item : m_board->Drawings() )
+        add( item, "board.drawings", "board", "" );
+
+    for( PCB_GROUP* group : m_board->Groups() )
+        add( group, "board.groups", "board", "" );
+
+    // Footprint children are the half the copper accessors never reach: a DRC
+    // marker naming a courtyard graphic, a silk field or a footprint's own UUID
+    // is unresolvable without them. Pads are emitted once above (BOARD::GetPads
+    // aggregates them), so only the remaining child lists are walked here.
+    for( FOOTPRINT* footprint : m_board->Footprints() )
+    {
+        const std::string reference = footprint->GetReference().ToStdString();
+        add( footprint, "board.footprints", "board", "" );
+
+        for( BOARD_ITEM* item : footprint->GraphicalItems() )
+            add( item, "footprint.graphics", "footprint", reference );
+
+        for( PCB_FIELD* field : footprint->GetFields( false ) )
+            add( field, "footprint.fields", "footprint", reference );
+
+        for( ZONE* zone : footprint->Zones() )
+            add( zone, "footprint.zones", "footprint", reference );
+
+        for( PCB_GROUP* group : footprint->Groups() )
+            add( group, "footprint.groups", "footprint", reference );
+    }
+
+    return result;
+}
