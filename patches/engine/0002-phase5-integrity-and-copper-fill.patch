+// UUIDs are not globally unique in some imported boards. Bind the KIID to the
+// physical pad inventory tuple; duplicate complete tuples are refused by Python.
+static std::string physicalPadIdentity( const PAD* pad, const FOOTPRINT* footprint )
+{
+    const VECTOR2I position = pad->GetPosition();
+    std::string layers;
+    for( PCB_LAYER_ID layer : pad->GetLayerSet().CuStack() )
+        layers += std::to_string( static_cast<int>( layer ) ) + ",";
+
+    const std::string reference = footprint
+            ? footprint->GetReference().ToStdString() : std::string();
+    return pad->m_Uuid.AsString().ToStdString() + "|"
+            + std::to_string( position.x ) + "|" + std::to_string( position.y ) + "|"
+            + std::to_string( pad->GetSizeX() ) + "|" + std::to_string( pad->GetSizeY() ) + "|"
+            + std::to_string( pad->GetNetCode() ) + "|" + layers + "|"
+            + reference + "." + pad->GetNumber().ToStdString();
+}
+
+// The item-kind token reported by getBoardItems(). It is derived from the
+// item's own KICAD_T (the DRC's own classification) rather than from a
+// hand-written class-name table, so a KiCad update that adds an item type shows
+// up as an explicit "other:<CLASS>" row instead of silently disappearing.
+static std::string boardItemKind( const BOARD_ITEM* item )
+{
+    switch( item->Type() )
+    {
+    case PCB_TRACE_T:           return "track";
+    case PCB_ARC_T:             return "arc";
+    case PCB_VIA_T:             return "via";
+    case PCB_PAD_T:             return "pad";
+    case PCB_ZONE_T:            return "zone";
+    case PCB_FOOTPRINT_T:       return "footprint";
+    case PCB_SHAPE_T:           return "shape";
+    case PCB_TEXT_T:            return "text";
+    case PCB_TEXTBOX_T:         return "textbox";
+    case PCB_FIELD_T:           return "field";
+    case PCB_TABLE_T:           return "table";
+    case PCB_TABLECELL_T:       return "table_cell";
+    case PCB_DIMENSION_T:
+    case PCB_DIM_ALIGNED_T:
+    case PCB_DIM_LEADER_T:
+    case PCB_DIM_CENTER_T:
+    case PCB_DIM_RADIAL_T:
+    case PCB_DIM_ORTHOGONAL_T:  return "dimension";
+    case PCB_TARGET_T:          return "target";
+    case PCB_GROUP_T:           return "group";
+    case PCB_GENERATOR_T:       return "generator";
+    case PCB_REFERENCE_IMAGE_T: return "reference_image";
+    case PCB_MARKER_T:          return "marker";
+    default:
+        return "other:" + item->GetClass().ToStdString();
+    }
+}
+
+// Physical (semantic) identity of one item: the UUID it carries plus the
+// properties that make two same-UUID items distinguishable without a distance
+// threshold. Rounded to the board's own integer units so a save/reopen cannot
+// change it. Pads reuse the collision-safe pad inventory tuple.
+static std::string boardItemSemantic( const BOARD_ITEM* item, const std::string& kind,
+                                      const std::string& parent_ref )
+{
+    if( const PAD* pad = dynamic_cast<const PAD*>( item ) )
+        return physicalPadIdentity( pad, pad->GetParentFootprint() );
+
+    const VECTOR2I position = item->GetPosition();
+    const BOX2I    box = item->GetBoundingBox();
+    return kind + "|" + item->m_Uuid.AsString().ToStdString() + "|"
+            + std::to_string( static_cast<int>( item->GetLayer() ) ) + "|"
+            + std::to_string( position.x ) + "," + std::to_string( position.y ) + "|"
+            + std::to_string( box.GetX() ) + "," + std::to_string( box.GetY() ) + ","
+            + std::to_string( box.GetWidth() ) + "," + std::to_string( box.GetHeight() ) + "|"
+            + parent_ref;
+}
