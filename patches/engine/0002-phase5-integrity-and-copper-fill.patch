+bool PNS_RL_ROUTER::fillZones( const std::string& rules_path )
+{
+    // Fail closed BEFORE any mutation. A refill is a whole-board derived-copper
+    // operation: doing it under the wrong clearance set would produce fills the
+    // caller never authorised, and doing it under *default* rules would silently
+    // discard the project's own.
+    if( m_boardQuarantined )
+        throw std::runtime_error( "fill_zones refused: board state is quarantined" );
+
+    if( isRouting() || isDragging() )
+        throw std::runtime_error(
+                "fill_zones refused: a routing session is active; finish or cancel "
+                "it before refilling derived copper" );
+
+    const wxString requestedRules = wxString::FromUTF8( rules_path );
+    if( !rules_path.empty() && !wxFileName::FileExists( requestedRules ) )
+        throw std::runtime_error(
+                "fill_zones refused: design rules file not found: " + rules_path );
+
+    BOARD_DESIGN_SETTINGS& bds = m_board->GetDesignSettings();
+    std::shared_ptr<DRC_ENGINE> previousEngine = bds.m_DRCEngine;
+
+    auto engine = std::make_shared<DRC_ENGINE>( m_board, &bds );
+    try
+    {
+        engine->InitEngine( wxFileName( requestedRules ) );
+        if( !engine->RulesValid() )
+            throw std::runtime_error( "DRC engine did not validate the selected rules" );
+    }
+    catch( ... )
+    {
+        // Rules that are present but unreadable are still a refusal: filling
+        // under a partially initialised engine would change copper under
+        // constraints nobody asked for.
+        throw std::runtime_error(
+                "fill_zones refused: design rules failed to load: " + rules_path );
+    }
+    engine->SetProgressReporter( nullptr );
+    bds.m_DRCEngine = engine;
+
+    bool filled = false;
+    std::string failure;
+    try
+    {
+        // A null commit is supported by ZONE_FILLER (it only calls commit->Modify
+        // when a commit was supplied); there is no undo stack in a headless run,
+        // and the caller keeps the pre-fill board as its own generation.
+        ZONE_FILLER filler( m_board, nullptr );
+        std::vector<ZONE*> zones;
+        for( ZONE* zone : m_board->Zones() )
+        {
+            // Non-copper zones can carry converted artwork in their stored fill;
+            // ZONE_FILLER rebuilds those from rectangular outlines. Refill only
+            // derived copper and preserve silk/mask artwork exactly.
+            if( zone && zone->IsOnCopperLayer() )
+                zones.push_back( zone );
+        }
+        filled = filler.Fill( zones );
+        if( !filled )
+            failure = "the zone filler reported that it did not complete";
+    }
+    catch( const std::exception& e )
+    {
+        failure = e.what();
+    }
+    catch( ... )
+    {
+        failure = "unknown exception";
+    }
+
+    // Restore the engine the router was using on every exit path, so a caller
+    // that catches the refusal still routes under the rules it had.
+    bds.m_DRCEngine = previousEngine;
+
+    // A failed filler may have modified some polygons before returning. No board
+    // snapshot covers zones, so quarantine the owning engine on any partial failure.
+    if( !filled )
+    {
+        m_boardQuarantined = true;
+        throw std::runtime_error( "fill_zones failed; board quarantined: " + failure );
+    }
+
+    // Filling invalidates connectivity and every DRC cache that described the
+    // previous copper: rebuild, and drop incremental signatures and violations.
+    try
+    {
+        m_board->BuildConnectivity();
+        resyncWorld();
+        recalculateRatsnest();
+        m_drcViolations.clear();
+        m_drcItemSig.clear();
+        m_lastDrcRulesPath.clear();
+    }
+    catch( ... )
+    {
+        m_boardQuarantined = true;
+        throw std::runtime_error( "fill_zones failed rebuilding connectivity; board quarantined" );
+    }
+    return true;
+}
