+std::vector<RLZonePointResult> PNS_RL_ROUTER::getZonePointHits(
+        const std::vector<std::tuple<double, double, int, double>>& queries ) const
+{
+    std::vector<RLZonePointResult> results;
+    results.reserve( queries.size() );
+
+    // Same containers SyncWorld reads: board zones plus footprint-scoped ones.
+    // Collected once per call — the zone list cannot change under a read-only
+    // accessor, and rebuilding it per query would be pure overhead.
+    std::vector<std::pair<ZONE*, std::string>> zones;
+
+    if( m_board )
+    {
+        for( ZONE* zone : m_board->Zones() )
+            zones.emplace_back( zone, "board.zones" );
+
+        for( FOOTPRINT* fp : m_board->Footprints() )
+            for( ZONE* zone : fp->Zones() )
+                zones.emplace_back( zone, "footprint.zones" );
+    }
+
+    for( size_t index = 0; index < queries.size(); ++index )
+    {
+        const double xMm     = std::get<0>( queries[index] );
+        const double yMm     = std::get<1>( queries[index] );
+        const int    layerId = std::get<2>( queries[index] );
+        const double windowMm = std::max( 0.0, std::get<3>( queries[index] ) );
+
+        RLZonePointResult result;
+        result.query_index   = static_cast<int>( index );
+        result.layer         = layerId;
+        result.status        = "unknown";
+        result.classification = "unknown";
+        result.fill_net_code = -1;
+        result.in_keepout    = false;
+        result.keepout_flags = 0;
+        result.fill_provenance = "no_fill";
+        result.zones_tested  = 0;
+
+        if( !m_board )
+        {
+            result.reason = "no board is loaded";
+            results.push_back( std::move( result ) );
+            continue;
+        }
+
+        // IsCopperLayer alone, not a range: this enum orders the stack as
+        // F_Cu=0, B_Cu=2, In1_Cu=4 (+2 per inner layer), so an inner layer is
+        // numerically *above* B_Cu and a F_Cu..B_Cu range check would silently
+        // refuse every inner layer.
+        if( layerId < F_Cu || !IsCopperLayer( static_cast<PCB_LAYER_ID>( layerId ) ) )
+        {
+            result.reason = "layer is not a copper layer";
+            results.push_back( std::move( result ) );
+            continue;
+        }
+
+        const PCB_LAYER_ID layer = static_cast<PCB_LAYER_ID>( layerId );
+        const VECTOR2I     point( nmFromMm( xMm ), nmFromMm( yMm ) );
+        const int          windowNm = nmFromMm( windowMm );
+
+        // Nets among the fill copper this point touches. -2 means "none yet";
+        // net -1 (netless fill) is a value like any other, because a point on
+        // netless copper is not on the candidate's net either. Tracking a
+        // first-value plus a conflict flag keeps the answer independent of zone
+        // iteration order without a container.
+        int  fillNet       = -2;
+        bool fillNetMulti  = false;
+        int  loadedHits    = 0;
+        int  unknownHits   = 0;
+
+        for( const std::pair<ZONE*, std::string>& entry : zones )
+        {
+            ZONE* zone = entry.first;
+
+            if( !zone )
+                continue;
+
+            const LSET layers = zone->GetLayerSet();
+
+            if( !layers.Contains( layer ) )
+                continue;                 // layer span: tested on every layer it is on
+
+            ++result.zones_tested;
+
+            RLZonePointHit hit;
+            hit.zone_uuid    = zone->m_Uuid.AsString().ToStdString();
+            hit.name         = zone->GetZoneName().ToStdString();
+            hit.source       = entry.second;
+            hit.layer        = layerId;
+            hit.net_code     = zone->GetNetCode();
+            hit.is_rule_area = zone->GetIsRuleArea();
+            hit.keepout_flags = 0;
+            hit.in_outline   = false;
+            hit.in_fill      = false;
+            hit.fill_is_island = false;
+            hit.distance_mm  = -1.0;
+            hit.fill_provenance = "no_fill";
+
+            if( hit.is_rule_area && zone->HasKeepoutParametersSet() )
+            {
+                // The same gate SyncWorld uses before adding PNS obstacles, so
+                // this agrees with the region the router itself treats as a
+                // keepout instead of with every rule area on the board.
+                if( zone->GetDoNotAllowTracks() )
+                    hit.keepout_flags |= 1;
+                if( zone->GetDoNotAllowVias() )
+                    hit.keepout_flags |= 2;
+                if( zone->GetDoNotAllowPads() )
+                    hit.keepout_flags |= 4;
+            }
+            else if( !hit.is_rule_area && zone->HasFilledPolysForLayer( layer ) )
+            {
+                const std::shared_ptr<SHAPE_POLY_SET>& fill =
+                        zone->GetFilledPolysList( layer );
+
+                // HasFilledPolysForLayer() is true for a zone whose layer entry
+                // exists but holds no polygons (a pour declared on the layer
+                // with no stored fill). Distance/containment on an empty set
+                // returns KiCad's "no segments" sentinel rather than 0, so an
+                // empty set has to be reported as "no fill to measure" instead
+                // of as a very large distance.
+                if( fill && !fill->IsEmpty() && fill->OutlineCount() > 0 )
+                {
+                    const SEG::ecoord squared = fill->SquaredDistance( point, false );
+
+                    // SquaredDistance returns 0 exactly when the point is
+                    // contained in the fill (holes excluded); otherwise it is
+                    // the squared distance to the nearest fill edge or void
+                    // wall. sqrt() is paid once per zone per query, not per
+                    // edge, because the accumulator is already squared.
+                    hit.distance_mm = mmFromNm(
+                            static_cast<int>( std::sqrt( static_cast<double>( squared ) ) ) );
+                    hit.in_fill = ( squared == 0 );
+                    hit.fill_provenance = "loaded_unverified";
+                    ++loadedHits;
+
+                    if( hit.in_fill )
+                    {
+                        if( fillNet == -2 )
+                            fillNet = hit.net_code;
+                        else if( fillNet != hit.net_code )
+                            fillNetMulti = true;
+
+                        for( int polygonIndex = 0;
+                             polygonIndex < fill->OutlineCount(); ++polygonIndex )
+                        {
+                            if( fill->Contains( point, polygonIndex, 1 )
+                                    && zone->IsIsland( layer, polygonIndex ) )
+                            {
+                                hit.fill_is_island = true;
+                                break;
+                            }
+                        }
+                    }
+                }
+                else if( fill )
+                {
+                    // Nothing to measure on this layer: reported as "no_fill",
+                    // never as a distance, and never as proof that the current
+                    // rules would put no copper here.
+                    hit.fill_provenance = "no_fill";
+                }
+                else
+                {
+                    hit.fill_provenance = "unknown";
+                    ++unknownHits;
+                }
+            }
+
+            const SHAPE_POLY_SET* outline = zone->Outline();
+            hit.in_outline = outline && outline->OutlineCount() > 0
+                             && outline->Contains( point, -1, 1 );
+
+            // A zone is a hit when the point is in it, on its copper, or within
+            // the query's own window of that copper. The window is what lets a
+            // caller test `distance_mm < margin` exactly: any zone close enough
+            // to satisfy that test is reported, and nothing else is.
+            const bool withinWindow = hit.distance_mm >= 0.0
+                                      && hit.distance_mm <= windowMm;
+
+            if( !hit.in_outline && !hit.in_fill && !withinWindow )
+                continue;                // the point is not near this zone at all
+
+            if( hit.is_rule_area && hit.keepout_flags != 0 )
+            {
+                result.in_keepout = true;
+                result.keepout_flags |= hit.keepout_flags;
+            }
+
+            result.hits.push_back( std::move( hit ) );
+        }
+
+        result.status = "resolved";
+
+        if( unknownHits > 0 )
+        {
+            result.fill_provenance = "unknown";
+        }
+        else if( loadedHits > 0 )
+        {
+            result.fill_provenance = "loaded_unverified";
+        }
+        else
+        {
+            result.fill_provenance = "no_fill";
+        }
+
+        if( fillNetMulti )
+        {
+            // A conflict is reported as one: several nets of pour copper cover
+            // this point, so naming any single one of them would hide the rest.
+            result.classification = "fill_multi_net";
+            result.fill_net_code  = -1;
+        }
+        else if( fillNet != -2 )
+        {
+            result.classification = "fill_single_net";
+            result.fill_net_code  = fillNet;
+        }
+        else if( result.hits.empty() )
+        {
+            result.classification = "no_zone";
+        }
+        else
+        {
+            result.classification = "outline_only";
+        }
+
+        results.push_back( std::move( result ) );
+    }
+
+    return results;
+}
+
+
