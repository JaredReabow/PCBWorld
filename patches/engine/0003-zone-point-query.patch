+/**
+ * Info struct returned by getZonePointHits() — one entry per zone that covers a
+ * queried point on the queried copper layer.
+ *
+ * A point/layer can be covered by several zones at once (overlapping pours, a
+ * pour under a rule area, an own-net island inside a foreign pour), so the
+ * accessor returns *every* covering zone rather than a single net; a caller that
+ * needs one answer must resolve the conflict itself or treat it as unknown.
+ *
+ * ``distance_mm`` is the geometric answer the point itself cannot give: the
+ * distance from the query point to this zone's *filled copper* on this layer —
+ * 0.0 when the point is on the copper, otherwise the distance to the nearest
+ * fill boundary or void wall, and -1.0 when the zone has no fill polygons for
+ * this layer to measure against. A caller turning a copper object of radius R
+ * that needs clearance C tests ``distance_mm < R + C``; that is a collision test
+ * on the *zone's* copper, not a promise about the rest of the board, and it
+ * never replaces the native DRC.
+ *
+ * ``fill_provenance`` is deliberately not a currency claim. KiCad clears
+ * ``NeedRefill()`` unconditionally when a board is parsed and only ever holds a
+ * fill hash the current process computed, so the engine cannot prove the loaded
+ * fill matches the loaded design rules. The honest values are:
+ *   "loaded_unverified" — the fill polygons came from the loaded board; whether
+ *                         the current rules would produce them is NOT verified.
+ *   "no_fill"           — this zone carries no fill polygons for this layer
+ *                         (nothing to measure; not a claim that copper is absent
+ *                         under the current rules).
+ *   "unknown"           — the zone could not be evaluated on this layer.
+ */
+struct RLZonePointHit
+{
+    std::string zone_uuid;          ///< the zone's KIID as a string
+    std::string name;               ///< zone name (may be empty)
+    std::string source;             ///< "board.zones" | "footprint.zones"
+    int         layer;              ///< PCB_LAYER_ID this hit was evaluated on
+    int         net_code;           ///< the zone's own net (-1 = netless)
+    bool        is_rule_area;       ///< GetIsRuleArea()
+    int         keepout_flags;      ///< bit0 tracks, bit1 vias, bit2 pads (rule areas)
+    bool        in_outline;         ///< point inside this zone's outline on this layer
+    bool        in_fill;            ///< point on this zone's filled copper (distance == 0)
+    bool        fill_is_island;     ///< the covering fill polygon is an insulated island
+    double      distance_mm;        ///< distance to this layer's filled copper (-1 = no fill)
+    std::string fill_provenance;    ///< "loaded_unverified" | "no_fill" | "unknown"
+};
+
+/**
+ * Result struct returned by getZonePointHits() — one entry per query, in query
+ * order, carrying *all* covering zones.
+ *
+ * ``classification`` resolves the copper question only, over the hits that
+ * report fill copper within the caller's own geometry (``in_fill``, or
+ * ``distance_mm`` compared by the caller):
+ *   "no_zone"        — no zone covers the point on this layer
+ *   "outline_only"   — covered by zone outline(s), no fill copper under the point
+ *   "fill_single_net"— fill copper of exactly one net; ``fill_net_code`` names it
+ *   "fill_multi_net" — fill copper of more than one net (a conflict: do not pick)
+ *   "unknown"        — the query could not be evaluated
+ *
+ * ``status`` is "resolved" only when every zone on this layer was evaluated;
+ * otherwise it is "unknown" and ``reason`` says why. Unknown is a first-class
+ * answer: callers must treat it as unknown, never as safe.
+ */
+struct RLZonePointResult
+{
+    int         query_index;        ///< index into the query list
+    int         layer;              ///< echo of the queried layer
+    std::string status;             ///< "resolved" | "unknown"
+    std::string reason;             ///< why the query is unknown ("" when resolved)
+    std::string classification;     ///< see above
+    int         fill_net_code;      ///< the single poured net, or -1
+    bool        in_keepout;         ///< a rule area with keepout params covers the point
+    int         keepout_flags;      ///< OR of the covering rule areas' flags
+    std::string fill_provenance;    ///< worst case over hits: unknown > loaded_unverified > no_fill
+    int         zones_tested;       ///< zones whose layer set covers this layer
+    std::vector<RLZonePointHit> hits;   ///< every covering zone, unordered by net
+};
