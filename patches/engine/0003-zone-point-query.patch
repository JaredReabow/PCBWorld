diff --git a/kicad-patches/rl/pns_rl_router.cpp b/kicad-patches/rl/pns_rl_router.cpp
index 079dba7..d1f775e 100644
--- a/kicad-patches/rl/pns_rl_router.cpp
+++ b/kicad-patches/rl/pns_rl_router.cpp
@@ -2328,6 +2328,242 @@ std::vector<RLZoneInfo> PNS_RL_ROUTER::getKeepouts() const
